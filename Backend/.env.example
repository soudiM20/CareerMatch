# Copy this file to .env and fill in real values. Never commit the real .env.
# Every variable below is actually read somewhere in Backend/ (see app.js,
# config/db.js, controllers/authController.js, services/flaskService.js).

# MongoDB connection string (config/db.js)
MONGO_URI=mongodb://localhost:27017/careermatch

# Secret used to sign/verify JWTs (controllers/authController.js,
# middleware/authMiddleware.js). Use a long, random value in real
# deployments — never reuse this placeholder.
JWT_SECRET=replace-with-a-long-random-secret

# Port the Express server listens on (app.js). Optional — defaults to 5000.
PORT=5000

# Comma-separated list of origins allowed by CORS (app.js). No trailing
# slashes. Include every frontend origin that will call this API.
FRONTEND_URLS=http://localhost:5173

# Base URL of the Flask recommendation service (services/flaskService.js).
# Optional — defaults to http://localhost:5001/recommend_candidate.
FLASK_API_URL=http://localhost:5001/recommend_candidate

# Shared secret for private Node → Flask recommendation requests.
FLASK_SERVICE_TOKEN=replace-with-a-long-random-service-token
