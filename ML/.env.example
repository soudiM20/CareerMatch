# app.py reads this directly via os.environ (no dotenv dependency here, so
# export it in your shell or your process manager rather than relying on a
# .env loader). Leave unset/anything other than "1" in any real deployment —
# debug mode enables the interactive Werkzeug debugger, which allows
# arbitrary code execution if this service is ever reachable from outside
# localhost.
FLASK_DEBUG=0

# Must match Backend/.env FLASK_SERVICE_TOKEN. Never expose this to the frontend.
FLASK_SERVICE_TOKEN=replace-with-a-long-random-service-token

# Render and other hosts provide PORT automatically; local default is 5001.
PORT=5001
